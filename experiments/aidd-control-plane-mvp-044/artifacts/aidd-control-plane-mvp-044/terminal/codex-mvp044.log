+    rollbackStopCondition: "",
+    readyReason: "",
+    aiddSpecConnections: [],
+    notes: ["execute_now以外の混入", "host.localのメモを参照"]
+  };
+}
+
+export function evaluateOneRunExecutionReadinessGate(gate: OneRunExecutionReadinessGate): OneRunExecutionReadinessReview {
+  const isEmpty = gate.statusSample === "empty" && !gate.sourceQueueId && !gate.executeNowActionId && !gate.codexCommand;
+  if (isEmpty) return { status: "empty", issues: [], readyReason: "" };
+
+  const issues: string[] = [];
+  const requiredCommands = ["pnpm run lint", "pnpm run typecheck", "pnpm run test", "pnpm run build", "pnpm run test:e2e", "pnpm run doctor:aidd"];
+  const requiredEvidence = ["terminal", "empty screenshot", "valid screenshot", "failure screenshot", "Playwright report"];
+  const requiredConnections = ["AI Task Packet", "Verification Evidence", "Review Record", "Rollback Plan"];
+  const commandText = gate.requiredVerificationCommands.join("\n");
+  const browserText = gate.browserProjects.join("\n").toLowerCase();
+  const evidenceText = gate.requiredEvidence.join("\n");
+  const combinedText = [
+    gate.sourceQueueId,
+    gate.executeNowActionId,
+    gate.actionLane,
+    gate.codexCommand,
+    gate.sandboxMode,
+    commandText,
+    gate.browserProjects.join("\n"),
+    evidenceText,
+    gate.rollbackStopCondition,
+    gate.readyReason,
+    gate.aiddSpecConnections.join("\n"),
+    gate.notes.join("\n")
+  ].join("\n");
+
+  if (!gate.sourceQueueId.trim()) issues.push("source queue不足");
+  if (!gate.executeNowActionId.trim()) issues.push("execute_now action不足");
+  if (gate.actionLane !== "execute_now" || /next_increment|learning_log/i.test(gate.executeNowActionId + "\n" + gate.notes.join("\n"))) issues.push("execute_now以外の混入");
+  if (!gate.codexCommand.trim()) issues.push("Codex command不足");
+  if (/(^|\s)(rm\s+-rf|sudo|curl\s+https?:|wget\s+https?:|ssh\s+|scp\s+|nc\s+)/i.test(gate.codexCommand)) issues.push("危険command");
+  if (!["danger-full-access", "workspace-write"].includes(gate.sandboxMode)) issues.push("sandbox不足");
+  for (const command of requiredCommands) if (!commandText.includes(command)) issues.push(`${command.replace("pnpm run ", "")} command不足`);
+  if (!(browserText.includes("chromium") && browserText.includes("firefox") && browserText.includes("webkit"))) issues.push("Firefox除外");
+  for (const evidence of requiredEvidence) if (!evidenceText.includes(evidence)) issues.push(`${evidence}不足`);
+  if (!evidenceText.includes("terminal")) issues.push("terminal evidence不足");
+  if (!evidenceText.includes("failure screenshot")) issues.push("failure screenshot不足");
+  if (!gate.rollbackStopCondition.trim()) issues.push("rollback不足");
+  for (const connection of requiredConnections) if (!gate.aiddSpecConnections.includes(connection)) issues.push("AIDD-Spec接続不足");
+  if (!gate.readyReason.trim()) issues.push("ready reason不足");
+  if (containsLocalPathOrHost(combinedText) || containsTailnetReference(combinedText) || /https?:\/\/(?:10\.|172\.(?:1[6-9]|2\d|3[01])\.|192\.168\.)/i.test(combinedText)) {
+    issues.push("local path / host / private network URL混入");
+  }
+
+  return {
+    status: issues.length === 0 ? "ready" : "blocked",
+    issues: Array.from(new Set(issues)),
+    readyReason: gate.readyReason
+  };
+}
+
 function createRunResultFinding(input: RunResultFinding): RunResultFinding {
   return input;
 }
