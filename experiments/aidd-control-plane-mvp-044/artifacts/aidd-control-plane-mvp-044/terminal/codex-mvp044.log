+  aiddSpecConnections: string[];
+  notes: string[];
+};
+
+export type OneRunExecutionReadinessReview = {
+  status: OneRunExecutionReadinessStatus;
+  issues: string[];
+  readyReason: string;
+};
+
 export type RunResultReviewOutcome = "passed" | "failed" | "needs_evidence";
 
