test("Review Finding Action QueueでReview Findingを行動キューへ変換しexecute_nowだけをprompt previewへ入れる", async ({ page }) => {
  await page.goto("/");

  await expect(page.getByRole("heading", { name: "Review Finding Action Queue: empty" })).toBeVisible();
  await expect(page.getByText("まだReview Finding Action Queueはありません。")).toBeVisible();
  await expect(page.getByText("source review receipt / finding list / priority rule / verification command / evidence requirement")).toBeVisible();

  await page.getByLabel("Review Record Receipt Synthesizerサンプル操作").getByRole("button", { name: "review valid" }).click();
  await page.getByLabel("Review Finding Action Queueサンプル操作").getByRole("button", { name: "action valid" }).click();
  await expect(page.getByRole("heading", { name: "Review Finding Action Queue: valid" })).toBeVisible();
  await expect(page.getByText("review finding action queueはvalidです")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue summary").getByText("source review id", { exact: true })).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue summary").getByText("queue id", { exact: true })).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue action items").getByText("action-mvp043-execute-now-001: execute_now")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue action items").getByText("action-mvp043-next-increment-001: next_increment")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue action items").getByText("action-mvp043-learning-log-001: learning_log")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue action items").getByText("priority reason").first()).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue action items").getByText("AI Task Packet patch").first()).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue action items").getByText("Codex prompt patch").first()).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue action items").getByText("verification commands").first()).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue action items").getByText("required evidence").first()).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue action items").getByText("rollback condition").first()).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue action items").getByText("AIDD-Spec connection").first()).toBeVisible();
  await expect(page.getByLabel("Codex prompt preview")).toContainText("action-mvp043-execute-now-001");
  await expect(page.getByLabel("Codex prompt preview")).not.toContainText("action-mvp043-next-increment-001");
  await expect(page.getByLabel("Codex prompt preview")).not.toContainText("action-mvp043-learning-log-001");
  await expect(page.getByLabel("Codex prompt preview")).toContainText("next_increment と learning_log はCodex prompt previewに混ぜません");

  await page.getByLabel("Review Finding Action Queueサンプル操作").getByRole("button", { name: "action failure" }).click();
  await expect(page.getByRole("heading", { name: "Review Finding Action Queue: failure" })).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue Finding").getByText("source不足")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue Finding").getByText("priority reason不足")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue Finding").getByText("lane不足")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue Finding").getByText("verification command不足")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue Finding").getByText("rollback不足")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue Finding").getByText("required evidence不足")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue Finding").getByText("Firefox除外")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue Finding").getByText("terminal evidence不足")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue Finding").getByText("failure screenshot不足")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue Finding").getByText("local path / host / private network URL混入")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue Finding").getByText("execute_now以外のprompt混入")).toBeVisible();
  await expect(page.getByLabel("Review Finding Action Queue Finding").getByText("AIDD-Spec接続不足").first()).toBeVisible();
});

