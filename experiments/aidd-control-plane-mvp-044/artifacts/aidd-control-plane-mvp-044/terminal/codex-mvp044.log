+export function createEmptyOneRunExecutionReadinessGate(): OneRunExecutionReadinessGate {
+  return {
+    statusSample: "empty",
+    sourceQueueId: "",
+    executeNowActionId: "",
+    actionLane: "",
+    codexCommand: "",
+    sandboxMode: "",
+    requiredVerificationCommands: [],
+    browserProjects: [],
+    requiredEvidence: [],
