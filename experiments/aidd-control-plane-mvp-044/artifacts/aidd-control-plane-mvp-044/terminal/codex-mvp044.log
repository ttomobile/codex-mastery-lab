+export type OneRunExecutionReadinessGateMode = "empty" | "valid" | "failure";
+export type OneRunExecutionReadinessStatus = "empty" | "ready" | "blocked";
+
+export type OneRunExecutionReadinessGate = {
+  statusSample: OneRunExecutionReadinessGateMode;
+  sourceQueueId: string;
+  executeNowActionId: string;
+  actionLane: ReviewFindingActionLane | "";
+  codexCommand: string;
+  sandboxMode: string;
+  requiredVerificationCommands: string[];
+  browserProjects: string[];
+  requiredEvidence: string[];
+  rollbackStopCondition: string;
+  readyReason: string;
+  aiddSpecConnections: string[];
+  notes: string[];
