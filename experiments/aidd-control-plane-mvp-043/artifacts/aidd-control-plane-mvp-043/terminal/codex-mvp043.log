+export type ReviewFindingActionQueueMode = "empty" | "valid" | "failure";
+export type ReviewFindingActionLane = "execute_now" | "next_increment" | "learning_log";
+
+export type ReviewFindingActionItem = {
+  actionId: string;
+  findingId: string;
+  findingCategory: ReviewRecordReceiptFindingCategory | "";
+  severity: RunResultFindingSeverity | "";
+  lane: ReviewFindingActionLane | "";
+  priorityReason: string;
+  aiTaskPacketPatch: string;
+  codexPromptPatch: string;
+  verificationCommands: string[];
+  requiredEvidence: string[];
+  rollbackCondition: string;
+  aiddSpecConnection: string[];
+};
+
+export type ReviewFindingActionQueue = {
+  statusSample: ReviewFindingActionQueueMode;
+  sourceReviewId: string;
+  queueId: string;
+  sourceInputs: string[];
