+export function createEmptyReviewFindingActionQueue(): ReviewFindingActionQueue {
+  return {
+    statusSample: "empty",
+    sourceReviewId: "",
+    queueId: "",
+    sourceInputs: [],
+    actionItems: [],
+    codexPromptPreview: "",
+    excludedLaneNotice: "",
