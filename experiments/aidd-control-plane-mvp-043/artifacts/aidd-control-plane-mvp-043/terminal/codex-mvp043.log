+
+export function createValidReviewFindingActionQueue(source: ReviewRecordReceiptSynthesizer = createValidReviewRecordReceiptSynthesizer()): ReviewFindingActionQueue {
+  const sourceFinding = source.findings[0];
+  const executeNow = createReviewFindingActionItem({
+    actionId: "action-mvp043-execute-now-001",
+    findingId: sourceFinding?.id ?? "review-record-receipt-mvp042-valid-001",
+    findingCategory: sourceFinding?.category ?? "standard_update",
+    severity: "critical",
+    lane: "execute_now",
+    priorityReason: "Review Record Receipt Synthesizerの結果を次回Codex実行へ渡す最短経路で、prompt混入防止と証跡要件を同時に検証できるため。",
+    aiTaskPacketPatch: "MVP043としてReview Finding Action Queueを追加し、Review Findingをexecute_now / next_increment / learning_logへ分ける。",
+    codexPromptPatch: "Review Finding Action Queueのexecute_now actionだけを実装してください。next_incrementとlearning_logはCodex prompt previewへ混ぜないでください。",
+    verificationCommands: ["pnpm run lint", "pnpm run typecheck", "pnpm run test", "pnpm run build", "pnpm run doctor:aidd", "pnpm run test:e2e"],
+    requiredEvidence: [
+      "terminal evidence: experiments/aidd-control-plane-mvp-043/artifacts/terminal/review-finding-action-queue.txt",
+      "failure screenshot: assets/aidd-control-plane-mvp043-failure.png",
+      "Chromium / Firefox / WebKit E2E log"
+    ],
+    rollbackCondition: "execute_now以外がCodex prompt previewへ混入、または検証コマンドと証跡が欠けた場合はqueueをfailureへ戻す。",
+    aiddSpecConnection: ["AI Task Packet", "Codex Prompt", "Verification Evidence", "Review Record", "Learning Log", "Rollback Plan"]
+  });
+  const nextIncrement = createReviewFindingActionItem({
+    actionId: "action-mvp043-next-increment-001",
+    findingId: "review-record-receipt-mvp042-valid-002",
+    findingCategory: "needed_upstream_info",
+    severity: "warning",
+    lane: "next_increment",
+    priorityReason: "別インクリメントで扱う調査と標準更新で、今回のexecute_nowに混ぜると完了条件が広がるため。",
+    aiTaskPacketPatch: "次回incrementでpriority ruleの説明を拡張する。",
+    codexPromptPatch: "next_increment用メモ。今回のCodex prompt previewへは入れない。",
+    verificationCommands: ["pnpm run doctor:aidd"],
+    requiredEvidence: ["Learning Log link", "次回AI Task Packet候補"],
+    rollbackCondition: "execute_nowの検証が失敗した場合は次回incrementへ進めない。",
+    aiddSpecConnection: ["AI Task Packet", "Verification Evidence", "Review Record", "Learning Log"]
+  });
+  const learningLog = createReviewFindingActionItem({
+    actionId: "action-mvp043-learning-log-001",
+    findingId: "review-record-receipt-mvp042-valid-003",
+    findingCategory: "learning_log",
+    severity: "info",
+    lane: "learning_log",
+    priorityReason: "実装対象ではなく、判断理由を記事とLearning Logへ残すため。",
+    aiTaskPacketPatch: "Learning Logへprompt混入防止の観察を記録する。",
+    codexPromptPatch: "learning_log用メモ。今回のCodex prompt previewへは入れない。",
+    verificationCommands: ["pnpm run doctor:aidd"],
+    requiredEvidence: ["Learning Log note"],
+    rollbackCondition: "Learning Logだけの内容がexecute_nowへ混ざった場合はprompt previewを再生成する。",
+    aiddSpecConnection: ["AI Task Packet", "Verification Evidence", "Review Record", "Learning Log"]
+  });
+  const actionItems = [executeNow, nextIncrement, learningLog];
+  return {
+    statusSample: "valid",
+    sourceReviewId: source.sourceReceiptId || "review-record-receipt-mvp042-valid",
+    queueId: "review-finding-action-queue-mvp043",
+    sourceInputs: ["source review receipt", "finding list", "priority rule", "verification command", "evidence requirement"],
+    actionItems,
+    codexPromptPreview: [
+      "Codex実装対象: Review Finding Action Queueのexecute_now actionだけを処理してください。",
+      `action id: ${executeNow.actionId}`,
+      `finding category: ${executeNow.findingCategory}`,
+      `priority reason: ${executeNow.priorityReason}`,
+      `AI Task Packet patch: ${executeNow.aiTaskPacketPatch}`,
+      `Codex prompt patch: ${executeNow.codexPromptPatch}`,
+      `verification commands: ${executeNow.verificationCommands.join(" / ")}`,
+      `required evidence: ${executeNow.requiredEvidence.join(" / ")}`,
+      `rollback condition: ${executeNow.rollbackCondition}`,
+      `AIDD-Spec connection: ${executeNow.aiddSpecConnection.join(" / ")}`,
+      "next_increment と learning_log は今回のprompt previewへ混ぜない。"
+    ].join("\n"),
+    excludedLaneNotice: "next_increment と learning_log はCodex prompt previewに混ぜません。",
+    aiddSpecConnections: ["AI Task Packet", "Codex Prompt", "Verification Evidence", "Review Record", "Learning Log", "Rollback Plan"]
+  };
+}
+
+export function createFailureReviewFindingActionQueue(): ReviewFindingActionQueue {
+  return {
