+        aiTaskPacketPatch: "PRIVATE_HOME_PATH/tmp/patch.md から <private-network-url>/action を見て反映する。",
+        codexPromptPatch: "next_increment用修正とlearning_log用メモもまとめて今すぐ実装する。Firefoxは除外してよい。",
+        verificationCommands: [],
+        requiredEvidence: [],
+        rollbackCondition: "",
+        aiddSpecConnection: []
+      })
+    ],
+    codexPromptPreview: "execute_now action-mvp043-broken\nnext_increment用修正\nlearning_log用メモ\nFirefox除外",
+    excludedLaneNotice: "",
+    aiddSpecConnections: []
+  };
+}
+
+export function evaluateReviewFindingActionQueue(queue: ReviewFindingActionQueue): ReviewFindingActionQueueReview {
+  const isEmpty = queue.statusSample === "empty" && !queue.sourceReviewId && queue.actionItems.length === 0;
+  if (isEmpty) return { status: "empty", issues: [], executeNowCount: 0, promptPreview: "" };
+
+  const issues: string[] = [];
+  const requiredInputs = ["source review receipt", "finding list", "priority rule", "verification command", "evidence requirement"];
+  const requiredConnections = ["AI Task Packet", "Codex Prompt", "Verification Evidence", "Review Record", "Learning Log", "Rollback Plan"];
+  const combinedText = [
+    queue.sourceReviewId,
+    queue.queueId,
+    queue.sourceInputs.join("\n"),
+    queue.codexPromptPreview,
+    queue.excludedLaneNotice,
+    queue.aiddSpecConnections.join("\n"),
+    ...queue.actionItems.flatMap((item) => [
+      item.actionId,
+      item.findingId,
+      item.findingCategory,
+      item.severity,
+      item.lane,
+      item.priorityReason,
+      item.aiTaskPacketPatch,
+      item.codexPromptPatch,
+      item.verificationCommands.join("\n"),
+      item.requiredEvidence.join("\n"),
+      item.rollbackCondition,
+      item.aiddSpecConnection.join("\n")
+    ])
+  ].join("\n");
+  const executeNowItems = queue.actionItems.filter((item) => item.lane === "execute_now");
+  const promptPreview = queue.codexPromptPreview;
+
+  if (!queue.sourceReviewId.trim() || !queue.queueId.trim() || !requiredInputs.every((input) => queue.sourceInputs.includes(input))) issues.push("source不足");
+  if (queue.actionItems.length === 0) issues.push("finding list不足");
+  for (const item of queue.actionItems) {
+    if (!item.priorityReason.trim()) issues.push(`${item.actionId}: priority reason不足`);
+    if (!item.lane) issues.push(`${item.actionId}: lane不足`);
+    if (item.verificationCommands.length === 0) issues.push(`${item.actionId}: verification command不足`);
+    if (!item.rollbackCondition.trim()) issues.push(`${item.actionId}: rollback不足`);
+    if (item.requiredEvidence.length === 0) issues.push(`${item.actionId}: required evidence不足`);
+    if (!item.verificationCommands.join("\n").includes("pnpm run test:e2e") && item.lane === "execute_now") issues.push("Firefox除外");
+    for (const connection of ["AI Task Packet", "Verification Evidence", "Review Record"]) {
+      if (!item.aiddSpecConnection.includes(connection)) issues.push(`${item.actionId}: AIDD-Spec接続不足`);
+    }
+  }
+  if (executeNowItems.length === 0) issues.push("execute_now不足");
+  if (!queue.actionItems.flatMap((item) => item.requiredEvidence).join("\n").toLowerCase().includes("terminal")) issues.push("terminal evidence不足");
+  if (!queue.actionItems.flatMap((item) => item.requiredEvidence).join("\n").toLowerCase().includes("failure")) issues.push("failure screenshot不足");
+  for (const item of queue.actionItems.filter((candidate) => candidate.lane !== "execute_now")) {
+    if (promptPreview.includes(item.actionId) || promptPreview.includes(item.codexPromptPatch) || promptPreview.includes(item.aiTaskPacketPatch)) {
+      issues.push("execute_now以外のprompt混入");
+    }
+  }
+  if (/next_increment用|learning_log用/.test(promptPreview)) issues.push("execute_now以外のprompt混入");
+  if (!queue.excludedLaneNotice.includes("next_increment") || !queue.excludedLaneNotice.includes("learning_log") || !queue.excludedLaneNotice.includes("混ぜ")) {
+    issues.push("execute_now以外のprompt混入");
+  }
+  for (const connection of requiredConnections) if (!queue.aiddSpecConnections.includes(connection)) issues.push("AIDD-Spec接続不足");
+  if (containsLocalPathOrHost(combinedText) || containsTailnetReference(combinedText) || /https?:\/\/(?:10\.|172\.(?:1[6-9]|2\d|3[01])\.|192\.168\.)/i.test(combinedText)) {
+    issues.push("local path / host / private network URL混入");
+  }
+
+  return {
+    status: issues.length === 0 ? "valid" : "failure",
+    issues: Array.from(new Set(issues)),
+    executeNowCount: executeNowItems.length,
+    promptPreview
+  };
+}
+
 function createRunResultFinding(input: RunResultFinding): RunResultFinding {
   return input;
 }
