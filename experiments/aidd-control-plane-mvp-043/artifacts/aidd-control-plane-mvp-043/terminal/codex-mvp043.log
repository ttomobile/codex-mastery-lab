export function evaluateReviewRecordReceiptSynthesizer(synthesizer: ReviewRecordReceiptSynthesizer): ReviewRecordReceiptSynthesizerReview {
  const isEmpty = synthesizer.statusSample === "empty" && !synthesizer.sourceReceiptId && synthesizer.findings.length === 0;
  if (isEmpty) return { status: "empty", issues: [] };

  const issues: string[] = [];
  const requiredConnections = ["AIDD-Spec v0.1", "standards/aidd-control-plane-mvp-v0.1.md", "AI Task Packet", "Verification Evidence", "Review Record", "Learning Log", "Rollback Plan"];
  const browserText = synthesizer.browserProjects.join(" / ").toLowerCase();
  const evidenceText = [
    synthesizer.terminalEvidence,
    synthesizer.failureScreenshot,
    synthesizer.evidenceReferences.join("\n")
  ].join("\n").toLowerCase();
  const combinedText = [
    synthesizer.sourceReceiptId,
    synthesizer.scoreReason,
    synthesizer.standardUpdate,
    synthesizer.aiTaskPacketDelta.join("\n"),
    synthesizer.codexPromptDelta,
    synthesizer.verificationCommand,
    synthesizer.learningLogNote,
    synthesizer.terminalEvidence,
    synthesizer.failureScreenshot,
    synthesizer.browserProjects.join("\n"),
    synthesizer.evidenceReferences.join("\n"),
    synthesizer.aiddSpecConnections.join("\n"),
    ...synthesizer.findings.flatMap((finding) => [
      finding.id,
      finding.category,
      finding.severity,
      finding.summary,
      finding.neededUpstreamInfo.join("\n"),
      finding.standardUpdate,
      finding.aiTaskPacketDelta,
      finding.codexPromptDelta,
      finding.verificationCommand,
      finding.learningLogNote
    ])
  ].join("\n");

  if (!synthesizer.sourceReceiptId.trim()) issues.push("source不足");
  if (synthesizer.score === null || !synthesizer.scoreReason.trim()) issues.push("score根拠不足");
  if (synthesizer.findings.length === 0) issues.push("review finding不足");
  for (const finding of synthesizer.findings) {
    if (!finding.category || !finding.severity || !finding.summary.trim()) issues.push(`${finding.id}: finding分類不足`);
    if (finding.neededUpstreamInfo.length === 0) issues.push(`${finding.id}: needed upstream info不足`);
    if (!finding.standardUpdate.trim()) issues.push(`${finding.id}: standard update不足`);
    if (!finding.aiTaskPacketDelta.trim()) issues.push(`${finding.id}: AI Task Packet delta不足`);
    if (!finding.codexPromptDelta.trim()) issues.push(`${finding.id}: Codex prompt delta不足`);
    if (!finding.verificationCommand.trim()) issues.push(`${finding.id}: verification command不足`);
    if (!finding.learningLogNote.trim()) issues.push(`${finding.id}: Learning Log接続不足`);
  }
  if (synthesizer.neededUpstreamInfo.length === 0) issues.push("needed upstream info不足");
  if (!synthesizer.standardUpdate.trim()) issues.push("standard update不足");
  if (synthesizer.aiTaskPacketDelta.length === 0) issues.push("AI Task Packet delta不足");
  if (!synthesizer.codexPromptDelta.trim()) issues.push("Codex prompt delta不足");
  if (!synthesizer.verificationCommand.trim()) issues.push("verification command不足");
  if (!synthesizer.learningLogNote.trim()) issues.push("Learning Log接続不足");
  if (!(browserText.includes("chromium") && browserText.includes("firefox") && browserText.includes("webkit"))) issues.push("Firefox除外");
  if (!evidenceText.includes("terminal")) issues.push("terminal evidence不足");
  if (!evidenceText.includes("failure")) issues.push("failure screenshot不足");
  for (const connection of requiredConnections) if (!synthesizer.aiddSpecConnections.includes(connection)) issues.push(`${connection}接続不足`);
  if (containsLocalPathOrHost(combinedText) || containsTailnetReference(combinedText) || /https?:\/\/(?:10\.|172\.(?:1[6-9]|2\d|3[01])\.|192\.168\.)/i.test(combinedText)) {
    issues.push("local path/host/private network URL混入");
  }

  return { status: issues.length === 0 ? "valid" : "failure", issues: Array.from(new Set(issues)) };
}

