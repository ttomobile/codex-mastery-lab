@@ -0,0 +1,22 @@
+import { expect, test } from "@playwright/test";
+
+test("タスク追加、完了切替、未完了のみ表示ができる", async ({ page }) => {
+  await page.goto("/");
+
+  await page.getByLabel("タスクを追加").fill("買い物リストを書く");
+  await page.getByRole("button", { name: "追加" }).click();
+
+  const addedTask = page.getByText("買い物リストを書く");
+  await expect(addedTask).toBeVisible();
+
+  await page
+    .getByRole("listitem")
+    .filter({ hasText: "買い物リストを書く" })
+    .getByRole("checkbox")
+    .check();
+
+  await page.getByLabel("未完了のみ表示").check();
+
+  await expect(addedTask).toBeHidden();
+  await expect(page.getByText("朝の予定を確認する")).toBeVisible();
+});
